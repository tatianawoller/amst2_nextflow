params {
    // Base paths
    basepath = '/lustre1/scratch/348/vsc34840'
    envpath= '/data/leuven/348/vsc34840/miniconda3/envs'
    scratch_base = '/lustre1/scratch/348/vsc34840'
    basepath_wsl='/home/tatiana/'
    
    // Input/output
    input_dir = "${params.basepath}/Anneke/mini_d2"
    outdir = "${params.basepath}/Anneke/results_d2"
    
    // References
    folder_sbs="sbs_align"
    folder_nsbs="nsbs_align" 
    folder_amst="amst"
    out_json0= "sbs.json"
    out_json1= "nsbs.json"
    output_sbs="sbs_aligned"
    json2="nsbs_zstep1.json"
    json3="combined.json" 
    json4="prealigned.json"
    out_amst="transforms.json"
    
    // nf-core/configs integration
    custom_config_version = 'master'
    custom_config_base = "https://raw.githubusercontent.com/nf-core/configs/${params.custom_config_version}"
    
    // Resource limits
//    max_cpus = 64
//    max_memory = 64 GB
//    max_time = 72.h

    //start resources
    n_workers=8
    base_memory_gb = 8
    base_time_mins = 30
    
    // Workflow parameters
    gaussian_sigma =  2
    z_step0 = 1
    z_step1 = 8
    n_workers = 8
    init_offset_meth = "init_elx"
    transform = "translation"
    automask = "non-zero"
    keepmeta=0
    median_radius=7
    transform_default="amst-bspline"
    transform_amst="bspline"
    default_elastix="elastix-params-amst-gs256.txt"
    elx="FinalGridSpacingInPhysicalUnits:128 GridSpacingSchedule:2.0,1.4,1.2,1.0"

    // SLURM
    slurm_account = 'lp_hack_bio_im'
}

// Load base config with resource defaults
//includeConfig 'conf/base.config'

// Load nf-core institutional configs (uses params.custom_config_base)
includeConfig !System.getenv('NXF_OFFLINE') && params.custom_config_base ? 
    "${params.custom_config_base}/nfcore_custom.config" : "/dev/null"

// Set working directory
workDir = "${params.scratch_base}/work_nextflow"

profiles{
    conda_tier2{ 
      conda.enabled=true
      process.conda="${params.envpath}/squirrel-env-nov25"
      }
    singularity_tier2{
        singularity.enabled= true
        singularity.autoMounts=true
        singularity.cacheDir= "${params.basepath_wsl}/.apptainer/cache"
        singularity.tmpDir = "${params.basepath_wsl}/.apptainer/tmp"
        runOptions = '''
        --containall --cleanenv
    '''
    }
    singularity_tier1{
        singularity.enabled= true
        singularity.autoMounts=true
        singularity.cacheDir= "${params.basepath_wsl}/.apptainer/cache"
        singularity.tmpDir = "${params.basepath_wsl}/.apptainer/tmp"
        runOptions = '''
        --containall --cleanenv
    '''
    }
    conda_wsl { 
      conda.enabled=true
      process.conda='/home/tatiana/miniconda3/envs/squirrel-env-nov25'
      }
    apptainer_wsl{
        apptainer.enabled= true
        apptainer.autoMounts= true
        apptainer.cacheDir= '${params.basepath_wsl}/.apptainer/cache'
        apptainer.tmpDir = '${params.basepath_wsl}/.apptainer/tmp'
        container = "${params.basepath_wsl}/squirrel_nov2025_nextflow/squirrel_nextflow.sif"
    }
    docker_wsl{
        docker.enabled=true
        container="squirrel_docker:latest"
    }
}


process {
    executor = 'slurm'
    errorStrategy = { task.exitStatus in [137,140,143] ? 'retry' : 'finish' }
    maxRetries = 3
    withName: 'ELASTIX_STACK_ALIGNMENT' {
        container= "${params.basepath}/containers/squirrel_nextflow.sif"
        clusterOptions= "--account=${params.slurm_account}  --cluster=genius --partition=batch --nodes=1"
        cpus= 8
        memory = '32 GB'
        publishDir = [
            path: {"${params.outdir}/prealign"},
            mode: 'copy',
            pattern: '*.{json}'
        ]
        ext.args =  [
            "--determine_bounds",
            "--initialize_offsets_method", "${params.init_offset_meth}",
            "--gaussian_sigma", "${params.gaussian_sigma}",
            "--transform", "${params.transform}",
            "--auto_mask", "${params.automask}",
            "--n_workers", "${params.n_workers}"
        ].join(' ').trim()
    }

    withName: 'ELASTIX_APPLY_MULTI_STACK_ALIGNMENT' {
        container= "${params.basepath}/containers/squirrel_nextflow.sif"
        clusterOptions= "--account=${params.slurm_account}  --cluster=genius --partition=batch --nodes=1"
        cpus= 8
        memory = '16 GB'
        publishDir = [
            path: {"${params.outdir}/prealign"},
            mode: 'copy',
            saveAs: { filename -> filename }
        ]
        ext.args =  [
            "--auto_pad",
            "--n_workers", "${params.n_workers}"
        ].join(' ').trim()
    }

    withName: 'ELASTIX_STACK_ALIGNMENT_2' {
        container= "${params.basepath}/containers/squirrel_nextflow.sif"
        clusterOptions= "--account=${params.slurm_account}  --cluster=genius --partition=batch --nodes=1"
        cpus= 8
        memory = '32 GB'
        time = { (params.base_time_mins * task.attempt).min }
        publishDir = [
            path: {"${params.outdir}/prealign"},
            mode: 'copy',
            pattern: '*.{json}'
        ]
        ext.args =  [
            "--gaussian_sigma", "${params.gaussian_sigma}",
            "--transform", "${params.transform}",
            "--auto_mask", "${params.automask}",
            "--n_workers", "${params.n_workers}"
        ].join(' ').trim()
    }
    withName: 'LINALG_OP' {
        container= "${params.basepath}/containers/squirrel_nextflow.sif"
        clusterOptions= "--account=${params.slurm_account}  --cluster=genius --partition=batch --nodes=1"
        cpus= 4
        memory = '2 GB'
        publishDir = [
            path: {"${params.outdir}/prealign"},
            mode: 'copy',
            pattern: 'prealigned.json'
        ]
    }
       withName: 'SQ_GENERATE_ELASTIX' {
        container= "${params.basepath}/containers/squirrel_nextflow.sif"
        clusterOptions= "--account=${params.slurm_account}  --cluster=genius --partition=batch --nodes=1"
        cpus= 4
        memory = '2 GB'
        publishDir = [
            path: {"${params.outdir}/amst"},
            mode: 'copy',
            pattern: 'elastix-params-amst-gs256.txt'
        ]
    }
       withName: 'SQ_AMST' {
        container= "${params.basepath}/containers/squirrel_nextflow.sif"
        clusterOptions= "--account=${params.slurm_account}  --cluster=genius --partition=batch --nodes=1"
        cpus= 8
        memory = '32 GB
        publishDir = [
            path: {"${params.outdir}/amst"},
            mode: 'copy',
            pattern: 'transforms.json'
        ]
        ext.args =  [
            "--gaussian_sigma", "${params.gaussian_sigma}",
            "--transform", "${params.transform_amst}",
            "--median_radius", "${params.median_radius}",
            "--n_workers", "${params.n_workers}"
        ].join(' ').trim()
    }
}
