// Enable conda
conda.enabled = true

// Parameters
params {
    yaml_prealign = "/home/twoller/AMST2/squirrel/params-prealign.yaml"
    output_sbs = "sbs_prealignment"
    outdir = "/home/twoller/AMST2/results"
}

// Process configuration
process {
    withName: 'ELASTIX_STACK_ALIGNMENT' {
        publishDir = [
            path: "${params.outdir}/sbs_alignment",
            mode: 'copy',
            pattern: "*.json"
        ]
        cpus = 2
        memory = '1.GB'
        time = '1.h'
    }
}
