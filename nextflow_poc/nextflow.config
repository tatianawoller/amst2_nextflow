// Enable conda and docker
conda.enabled = true
docker.enabled = false  // Set to true when using Docker

// Docker configuration
docker {
    temp = 'auto'
    runOptions = '-u $(id -u):$(id -g)'
}

// Parameters
params {
    yaml_prealign = "/home/tatiana/squirrel/params-prealign.yaml"
    yaml_amst= "/home/tatiana/squirrel/params-amst.yaml"
    output_sbs = "/home/tatiana/squirrel/results/prealign/sbs_alignment"
    outdir = "/home/tatiana/squirrel/results/prealign"
    outdir_amst = "/home/tatiana/squirrel/results/amst"
    output_extension = '{tif,tiff,json}'
}

// Process configuration with container support
process {
    // Default container for all processes (uncomment when using Docker)
    // container = 'your-dockerhub-username/squirrel:latest'
    
    withName: 'ELASTIX_STACK_ALIGNMENT_SBS' {
        publishDir = [
            path: "${params.outdir}",
            mode: 'copy',
            pattern: "*.json"
        ]
        cpus = 2
        memory = '1.GB'
        time = '1.h'
    }
    withName: 'APPLY_ELASTIX_ALIGNMENT' {
        publishDir = [
            path: "${params.outdir}/sbs_alignment",
            mode: 'copy',
            pattern: "*.tif"
        ]
        cpus = 2
        memory = '1.GB'
        time = '1.h'
    }
    withName: 'ELASTIX_STACK_ALIGNMENT_NBS' {
        publishDir = [
            path: "${params.outdir}",
            mode: 'copy',
            pattern: "*.json"
        ]
        cpus = 2
        memory = '1.GB'
        time = '1.h'
    }
    withName: 'APPLY_ELASTIX_PREALIGNMENT' {
        publishDir = [
        [
            path: "${params.outdir}/pre_alignment",
            mode: 'copy',
            pattern: "*.tif"
        ],
        [
            path: "${params.outdir}/pre_alignment", 
            mode: 'copy',
            pattern: "*.tiff"
        ],
        [
            path: "${params.outdir}/pre_alignment",
            mode: 'copy', 
            pattern: "*.json"
        ]
        ]
        cpus = 2
        memory = '1.GB'
        time = '1.h'
    }
        withName: 'AMST' {
        publishDir = [
        [
            path: "${params.outdir_amst}",
            mode: 'copy',
            pattern: "transform*.txt"
        ],
        [
            path: "${params.outdir_amst}",
            mode: 'copy',
            pattern: "elastix-params-amst-gs256.txt"
        ],
        ]
        cpus = 2
        memory = '1.GB'
        time = '1.h'
    }
     withName: 'APPLY_AMST' {
        publishDir = [
            path: "${params.outdir_amst}/amst",
            mode: 'copy',
            pattern: "*.tif"
        ]
        cpus = 2
        memory = '1.GB'
        time = '1.h'
    }
}
