nextflow_process {

    name "Test creation amst transforms"
    script "../main.nf"
    process "SQ_AMST"
    tag "amst"
    tag "amst"

    test("amst") {

        when {
            params {
               module_args= "--gaussian_sigma 2.0 --transform bspline --median_radius 7"
            }
            process {
                config "/home/tatiana/vib_bic_nextflow/amst2_nextflow/modules/local/sq_amst/tests/nextflow.config"
                """
                input[0] = tuple(
                "/home/tatiana/test_amst2/nsbs_align",                    
                "transform_json",
                file("/home/tatiana/test_amst2/json_files/elastix-params-amst-gs256.txt"))
                """
            }
        }

       then {
          assertAll(
               { assert process.success },
                { assert path(process.out.json_transform[0]).exists() },
                {assert snapshot(process.out.json_transform[0]).match("amst")}
            )
        }
    }

    test("stub") {

        options "-stub"

        when {
            params {
                module_args= "--gaussian_sigma 2.0 --transform bspline --median_radius 7"
            }
            process {
                config "/home/tatiana/vib_bic_nextflow/amst2_nextflow/modules/local/sq_amst/tests/nextflow.config"
                """
                input[0] = tuple(
                "/home/tatiana/test_amst2/nsbs_align",                   
                "transform_json",
                file("/home/tatiana/test_amst2/json_files/elastix-params-amst-gs256.txt"))
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match()}
            )
        }
    }
}
