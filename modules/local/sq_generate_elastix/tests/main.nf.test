nextflow_process {

    name "Test generate elastix paramaters"
    script "../main.nf"
    process "SQ_GENERATE_ELASTIX"
    tag "amst"
    tag "sq_generate_elastix_params"

    test("generate_elastix_params") {

        when {

            process {
                config "/home/tatiana/vib_bic_nextflow/amst2_nextflow/modules/local/sq_generate_elastix/tests/nextflow.config"
                """
                input[0] = tuple(
                "elastix-params-amst-gs256.txt",                   
                "amst-bspline",
                "FinalGridSpacingInPhysicalUnits:128 GridSpacingSchedule:2.0,1.4,1.2,1.0")
                """
            }
        }

       then {
          assertAll(
               { assert process.success },
                { assert process.out.elastix_default_params.size() >= 1},
                { assert path(process.out.elastix_default_params[0]).exists() },
                {assert snapshot(process.out.elastix_default_params[0]).match("generate_elastix_params")}
            )
        }
    }

    test("stub") {

        options "-stub"

        when {
                process {
                config "/home/tatiana/vib_bic_nextflow/amst2_nextflow/modules/local/sq_generate_elastix/tests/nextflow.config"
                """
                input[0] = tuple(
                "elastix-params-amst-gs256.txt",                    
                "amst-bspline",
                 "FinalGridSpacingInPhysicalUnits:128 GridSpacingSchedule:2.0,1.4,1.2,1.0")
                """
            }
            
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match()}
            )
        }
    }
}
